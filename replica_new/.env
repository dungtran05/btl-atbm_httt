# Gốc URL của Leader (backend DocumentChain), ví dụ http://127.0.0.1:8000
# Replica gọi GET {LEADER_URL}/chain để đồng bị định kỳ.
LEADER_URL=http://127.0.0.1:8000

# Chu kỳ đồng bị với leader (giây). Đặt 0 để tắt luồng đồng bị định kỳ (vẫn có thể POST /replica/sync).
LEADER_SYNC_INTERVAL_S=5

# Định kỳ verify chain + checksum cục bộ (giây).
VERIFY_INTERVAL_S=30

# Khi chain local và leader lệch (fork hoặc cùng độ dài nhưng checksum khác): có ghi đè theo leader không (khuyến nghị true cho replica phụ).
SYNC_TRUST_LEADER=true

# Khóa công khai để verify chữ ký block (copy từ leader keys/public_key.pem).
KEY_DIR=./keys

# Khi main + backup đều hỏng: kéo từ các URL này (phân tách dấu phẩy), sau LEADER_URL.
PEER_REPLICAS=

HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
