# Gốc URL của Leader (backend DocumentChain), ví dụ http://127.0.0.1:8000 hoặc http://IP_RADMIN:8000
# Replica gọi GET {LEADER_URL}/chain để đồng bộ định kỳ / khi mở trang / hoặc GET|POST /replica/sync.
LEADER_URL=http://26.56.51.142:8000

# Timeout HTTP khi gọi Leader/peers (giây).
LEADER_FETCH_TIMEOUT_S=15

# Chu kỳ đồng bộ với leader (giây). Đặt 0 để tắt luồng nền (vẫn đồng bộ khi mở / hoặc GET|POST /replica/sync).
LEADER_SYNC_INTERVAL_S=5

# Mở http://<replica>:<port>/ trên trình duyệt có chạy đồng bộ ngay không (true|false).
SYNC_ON_ROOT_GET=true

# CORS cho trình duyệt: * hoặc danh sách origin cách nhau bởi dấu phẩy.
REPLICA_CORS_ORIGINS=*

# Định kỳ verify chain + checksum cục bộ (giây).
VERIFY_INTERVAL_S=30

# Khi chain local và leader lệch (fork hoặc cùng độ dài nhưng checksum khác): có ghi đè theo leader không (khuyến nghị true cho replica phụ).
SYNC_TRUST_LEADER=true

# Khóa công khai để verify chữ ký block (copy từ leader keys/public_key.pem).
KEY_DIR=./keys

# Khi main + backup đều hỏng: kéo từ các URL này (phân tách dấu phẩy), sau LEADER_URL.
PEER_REPLICAS=

HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
